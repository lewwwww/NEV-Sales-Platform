<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 映射接口全限定类名 -->
<mapper namespace="com.qf.mapper.SystemintroDao">
    <!-- 基础列表查询 -->
    <select id="selectListView" resultType="com.qf.entity.SystemintroEntity">
        select * from systemintro
        <where>
            1=1 ${ew.sqlSegment}
        </where>
        order by addtime desc
    </select>

    <!-- 分组统计（如按标题分组统计数量） -->
    <select id="selectGroup" resultType="map">
        select ${params.column},count(1) total
        from systemintro
        <where>1=1 ${ew.sqlSegment}</where>
        group by ${params.column}
        limit 10
    </select>
</mapper>